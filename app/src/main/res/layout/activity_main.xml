<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MotionSentinel"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0F1A16"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_inactive"
                android:textSize="16sp"
                android:textColor="#3B4A44"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Охрана"
                        android:textColor="#0F1A16"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textSize="18sp"
                        android:paddingBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/activateButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activate"
                        android:backgroundTint="#FF6F00"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deactivateButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/deactivate"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#1B5E20"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sirenSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/siren"
                        android:layout_marginTop="12dp"
                        android:textColor="#3B4A44" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Тревога"
                        android:textColor="#0F1A16"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textSize="18sp"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sensitivity"
                        android:textColor="#3B4A44" />

                    <SeekBar
                        android:id="@+id/sensitivitySeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_interval"
                    android:layout_marginTop="12dp"
                    android:textColor="#3B4A44" />

                    <EditText
                        android:id="@+id/repeatIntervalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="#0F1A16"
                        android:textColorHint="#8A9691"
                        android:backgroundTint="#FF6F00" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_delay"
                        android:layout_marginTop="12dp"
                        android:textColor="#3B4A44" />

                <EditText
                    android:id="@+id/gpsDelayInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#0F1A16"
                    android:textColorHint="#8A9691"
                    android:backgroundTint="#FF6F00" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/monitor_interval"
                    android:layout_marginTop="12dp"
                    android:textColor="#3B4A44" />

                <EditText
                    android:id="@+id/monitorIntervalInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#0F1A16"
                    android:textColorHint="#8A9691"
                    android:backgroundTint="#FF6F00" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/highFreqAlertSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/high_freq_alert"
                    android:layout_marginTop="12dp"
                    android:textColor="#3B4A44" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activation_delay"
                    android:layout_marginTop="12dp"
                    android:textColor="#3B4A44" />

                <EditText
                    android:id="@+id/activationDelayInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#0F1A16"
                    android:textColorHint="#8A9691"
                    android:backgroundTint="#FF6F00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Telegram"
                        android:textColor="#0F1A16"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textSize="18sp"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/telegram_token"
                        android:textColor="#3B4A44" />

                    <EditText
                        android:id="@+id/tokenInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#0F1A16"
                        android:textColorHint="#8A9691"
                        android:backgroundTint="#FF6F00" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/telegram_chat_id"
                        android:layout_marginTop="12dp"
                        android:textColor="#3B4A44" />

                    <EditText
                        android:id="@+id/chatIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#0F1A16"
                        android:textColorHint="#8A9691"
                        android:backgroundTint="#FF6F00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_lock"
                        android:textColor="#0F1A16"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textSize="18sp"
                        android:paddingBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/biometricSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/use_biometrics"
                        android:textColor="#3B4A44" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:backgroundTint="#FF6F00"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3F6F5"
        android:alpha="0.98"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
